<resources>
    <style name="Theme.BroadcastMedia" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/primary</item>
        <item name="android:windowBackground">@color/white</item>
        <item name="android:statusBarColor">@color/white</item>
    </style>

    <style name="DrawerShape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopRight">@dimen/drawer_corner</item>
        <item name="cornerSizeBottomRight">@dimen/drawer_corner</item>
        <item name="cornerSizeTopLeft">0dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
    </style>

    <style name="PillButton" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="backgroundTint">@color/pill_bg</item>
        <item name="android:textColor">@color/pill_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/body_text_size</item>
        <item name="cornerRadius">@dimen/pill_corner</item>
    </style>
</resources>
